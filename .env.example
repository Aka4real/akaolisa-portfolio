# Optional Resend Email Delivery (Contact Form)
# Without this key, /api/contact validates inquiries, logs them into the Admin Inbox, and returns a graceful mailto/copy fallback.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Inquiry <onboarding@resend.dev>
CONTACT_TO_EMAIL=akaolisaenwedo4real@gmail.com

# Optional Google Gemini API (AI Q&A Drawer)
# Without GEMINI_API_KEY, /api/chat runs an instant deterministic grounded knowledge engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=LOW
GEMINI_MAX_OUTPUT_TOKENS=4096

# Admin Mission Control (/admin) — REQUIRED IN PRODUCTION
# In local development only, omitting ADMIN_PASSWORD enables a clearly labeled dev passphrase fallback.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional Distributed Telemetry Persistence (Recommended for Vercel Serverless / Multi-Instance)
# Supports Upstash Redis REST or Vercel KV REST. Without these, Linux VPS / Docker / Local Dev
# automatically uses atomic local disk persistence (.telemetry-data/telemetry-store.json).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional custom directory for local disk telemetry storage on VPS / Docker volumes
TELEMETRY_DATA_DIR=

# Optional Canonical Production URL (used for sitemap & OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://www.oxakalabs.xyz
